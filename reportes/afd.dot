digraph AFD_PromptZal {
    rankdir=LR;
    nodesep=0.6;
    ranksep=1.0;
    dpi=150;
    splines=true;
    graph [fontname="Helvetica", fontsize=12, labelloc=b, labeljust=l, label="L: letra o _     D: dígito     C: cualquiera salvo \" y salto de línea\nN: cualquiera salvo salto de línea     B: cualquiera salvo *     X: cualquiera salvo * y /\notro: cualquier carácter no listado     rojo punteado: error léxico\nlínea azul punteada: el lexema aceptado en q1 se busca en la lista; si no está, es ID"];
    node [shape=circle, fontname="Helvetica", fontsize=12, style=filled, fillcolor=white, color=black];
    edge [fontname="Helvetica", fontsize=11, fontcolor=blue, color=gray30];

    inicio [shape=point, width=0];
    inicio -> q0;

    q1 [shape=doublecircle, label="q1\nID"];
    q8 [shape=doublecircle, label="q8\nDIRECTIVA"];
    q11 [shape=doublecircle, label="q11\nDIRECTIVA"];
    q18 [shape=doublecircle, label="q18\nDIRECTIVA"];
    q19 [shape=doublecircle, label="q19\nNUMERO"];
    q21 [shape=doublecircle, label="q21\nNUMERO"];
    q23 [shape=doublecircle, label="q23\nCADENA"];
    q24 [shape=doublecircle, label="q24\nIGUAL"];
    q25 [shape=doublecircle, label="q25\nMAS"];
    q27 [shape=doublecircle, label="q27\nFLECHA"];
    q28 [shape=doublecircle, label="q28\nLLAVE_A"];
    q29 [shape=doublecircle, label="q29\nLLAVE_C"];
    q30 [shape=doublecircle, label="q30\nPAR_A"];
    q31 [shape=doublecircle, label="q31\nPAR_C"];
    q32 [shape=doublecircle, label="q32\nCOMA"];
    qerr [shape=circle, fillcolor="#ffe3e3", color=red];

    cat0 [shape=box, style="rounded,filled", fillcolor="#fff9db", fontsize=11, label="PALABRAS RESERVADAS (cada una, su terminal)\l  AGENTE → AGENTE\l  contexto → CONTEXTO\l  variable → VARIABLE\l  EJECUTAR → EJECUTAR\l  EXPORTAR → EXPORTAR\l"];
    q1 -> cat0 [style=dashed, color="#2b6cb0", fontcolor="#2b6cb0", label="  lexema en la lista  "];
    cat1 [shape=box, style="rounded,filled", fillcolor="#fff9db", fontsize=11, label="COMANDOS DE IA (COMANDO_IA)\l  PREGUNTAR\l  GENERAR\l  RESUMIR\l  ANALIZAR\l  TRADUCIR\l  CLASIFICAR\l  EXTRAER\l"];
    q1 -> cat1 [style=dashed, color="#2b6cb0", fontcolor="#2b6cb0", label="  lexema en la lista  "];
    cat2 [shape=box, style="rounded,filled", fillcolor="#fff9db", fontsize=11, label="FUNCIÓN DEL SISTEMA (CARGAR)\l  CARGAR\l"];
    q1 -> cat2 [style=dashed, color="#2b6cb0", fontcolor="#2b6cb0", label="  lexema en la lista  "];
    cat3 [shape=box, style="rounded,filled", fillcolor="#fff9db", fontsize=11, label="CONECTORES (CONECTOR)\l  SOBRE\l  DESDE\l  EN\l  COMO\l"];
    q1 -> cat3 [style=dashed, color="#2b6cb0", fontcolor="#2b6cb0", label="  lexema en la lista  "];

    q0 -> q1 [label="  L  "];
    q1 -> q1 [label="  D  "];
    q0 -> q2 [label="  @  "];
    q2 -> qerr [label="  otro  ", style=dashed, color=red, fontcolor=red];
    q2 -> q3 [label="  m  "];
    q3 -> qerr [label="  otro  ", style=dashed, color=red, fontcolor=red];
    q3 -> q4 [label="  o  "];
    q4 -> qerr [label="  otro  ", style=dashed, color=red, fontcolor=red];
    q4 -> q5 [label="  d  "];
    q5 -> qerr [label="  otro  ", style=dashed, color=red, fontcolor=red];
    q5 -> q6 [label="  e  "];
    q6 -> qerr [label="  otro  ", style=dashed, color=red, fontcolor=red];
    q6 -> q7 [label="  l  "];
    q7 -> qerr [label="  otro  ", style=dashed, color=red, fontcolor=red];
    q7 -> q8 [label="  o  "];
    q2 -> q9 [label="  r  "];
    q9 -> qerr [label="  otro  ", style=dashed, color=red, fontcolor=red];
    q9 -> q10 [label="  o  "];
    q10 -> qerr [label="  otro  ", style=dashed, color=red, fontcolor=red];
